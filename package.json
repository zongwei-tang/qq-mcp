{
  "name": "qq-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives your own QQ account: 260 tools for messages, groups, files and QQ空间 (Qzone), with cloud deploy, Streamable HTTP and automatic re-login",
  "type": "module",
  "bin": {
    "qq-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@snowluma/mcp": "2.4.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "qq",
    "qzone",
    "onebot",
    "snowluma",
    "model-context-protocol"
  ]
}
