{
  "name": "qq-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives your own QQ account: 280+ tools for messages, groups, files, QQ 空间 (Qzone) and more, over stdio or Streamable HTTP",
  "type": "module",
  "bin": {
    "qq-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && cp src/catalog/actions.json dist/catalog/",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
